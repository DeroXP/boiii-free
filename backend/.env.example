# Copy to backend/.env for local development (the app reads it from the working directory).
# Placeholders only. Never commit real values; on Railway set them in the service's Variables.

# production | development | test. Production refuses to start without the secrets below.
XERCES_ENV=development

# Local default: a SQLite file. Production: the Railway PostgreSQL reference variable,
# ${{Postgres.DATABASE_URL}} (postgres:// and postgresql:// URLs are converted for asyncpg).
# Special characters in the password may stay as they are; only % must be written %25.
DATABASE_URL=sqlite+aiosqlite:///./xerces-dev.db

# Ed25519 signing key (base64url 32-byte seed or PEM), its key id, and the secret used to hash
# client addresses for rate limiting. Generate all three with: python scripts/genkey.py
# Left empty in development, throwaway values are generated at startup.
XERCES_TOKEN_PRIVATE_KEY=
XERCES_TOKEN_KEY_ID=
XERCES_RATE_LIMIT_SECRET=

# Optional, for key rotation: JSON object of old key ids to PEM public keys.
XERCES_TOKEN_EXTRA_PUBLIC_KEYS=

# Bearer token for the crash-report admin routes (/v1/admin/...); scripts/crashes.py sends it.
# At least 32 characters; generate one with: python scripts/genkey.py --admin
# Left empty, the admin routes answer 404.
XERCES_ADMIN_TOKEN=

# 1 behind Railway's edge proxy (client address from X-Forwarded-For), 0 otherwise. With 0,
# start.sh also tells uvicorn to ignore X-Forwarded-For, so clients cannot forge their address.
XERCES_TRUST_PROXY=0

# Which X-Forwarded-For entry is the client, with XERCES_TRUST_PROXY=1: 0 = the first entry (an
# edge that replaces the header, as Railway's does); N = the Nth entry from the right. On Railway
# use 2 only if its edge starts appending to the client's header. See README.md.
XERCES_PROXY_HOPS=0

# Argon2id cost (OWASP minimum: 2 iterations, 19456 KiB, 1 lane).
XERCES_ARGON2_TIME_COST=2
XERCES_ARGON2_MEMORY_KIB=19456
XERCES_ARGON2_PARALLELISM=1

# Port uvicorn listens on (Railway sets it).
PORT=8080
