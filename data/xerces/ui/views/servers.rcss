/* Servers (DESIGN.md 7.3): the same two columns as Home, a wide primary
   column (direct connect, favourites) and a narrow aside (recent, public
   list, offline). Rules, not boxes; the accent marks only the main action,
   the focus ring and problems. */

#servers-main
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: flex-start;
	gap: 40dp;
	padding: 32dp 32dp 40dp 32dp;
	box-sizing: border-box;
}
.servers-primary { flex: 999 1 560dp; max-width: 880dp; }
.servers-aside { flex: 1 1 260dp; display: flex; flex-direction: column; gap: 40dp; }

.game-box { margin-top: 24dp; }
.game-text { margin-top: 6dp; }
.game-action { margin-top: 12dp; }

/* ------------------------------------------------------- direct connect */
.join-modes
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	column-gap: 32dp;
	row-gap: 8dp;
	border-bottom: 1dp var(--line);
}
.mode-group { display: flex; flex-direction: row; column-gap: 28dp; }
.mode
{
	gap: 8dp;
	min-height: 44dp;
	padding: 0dp 2dp;
	margin-bottom: -1dp;
	border-bottom: 2dp transparent;
	color: var(--text2);
	font-size: 15dp;
	font-weight: 600;
	letter-spacing: -0.15dp;
}
.mode .mark-dot { display: block; width: 8dp; height: 8dp; }
.mode.on { color: var(--text); border-bottom-color: var(--text); }
.mode.on .mark-dot { background-color: var(--accent); }
.mode:hover { color: var(--text); }

.field-label { margin-top: 24dp; margin-bottom: 8dp; }
input.address
{
	width: 100%;
	min-height: 56dp;
	padding: 17dp 16dp;
	font-size: 18dp;
	line-height: 22dp;
}
input.text:placeholder-shown { color: var(--text2); }
input.address.invalid { border-color: var(--accent); }
.field-problem { margin-top: 8dp; font-size: 13dp; line-height: 18dp; color: var(--accent-text); }
.field-note { margin-top: 8dp; font-family: "IBM Plex Mono"; font-size: 12dp; line-height: 16dp; color: var(--text2); }

.join-row { margin-top: 20dp; }
.join { gap: 12dp; }
.join .key { border-color: var(--text2); }
.primary-button.join .key { border-color: var(--on-accent); color: var(--on-accent); }
.outline.join:hover .key { border-color: var(--bg); color: var(--bg); }
.join-note { margin-top: 12dp; font-family: "IBM Plex Mono"; font-size: 12dp; line-height: 16dp; color: var(--text2); }

.result { margin-top: 24dp; padding-top: 12dp; border-top: 1dp var(--text); }
.result.failed { border-top-color: var(--accent); }
.result.failed .result-label { color: var(--accent-text); }
.result-target { margin-top: 6dp; font-family: "IBM Plex Mono"; font-size: 13dp; line-height: 18dp; font-weight: 500; }
.result-message { margin-top: 6dp; font-size: 15dp; line-height: 20dp; font-weight: 600; }
.result-line { padding: 8dp 0dp; border-bottom: 1dp var(--line); font-size: 13dp; line-height: 18dp; color: var(--text2); }
.result-command
{
	margin-top: 12dp;
	padding: 10dp 12dp;
	border-left: 2dp var(--line);
	background-color: var(--surface);
	font-family: "IBM Plex Mono";
	font-size: 12dp;
	line-height: 18dp;
	color: var(--text2);
	word-break: break-all;
}

.result-action { margin-top: 12dp; }

/* ----------------------------------------------------------- favourites */
.server-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 16dp;
	padding: 12dp 0dp;
	border-bottom: 1dp var(--line);
}
.server-text { flex: 1 1 auto; }
.server-name { font-size: 15dp; font-weight: 600; line-height: 20dp; word-break: break-word; }
.server-address { margin-top: 4dp; font-family: "IBM Plex Mono"; font-size: 12dp; line-height: 16dp; color: var(--text2); word-break: break-all; }
.row-actions { display: flex; flex-direction: row; align-items: center; gap: 8dp; }

.fav-form { margin-top: 8dp; }
.fav-form.editing .field-label { color: var(--accent-text); }
.fav-fields { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 12dp; }
input.fav-name { flex: 1 1 200dp; width: 200dp; }
input.fav-address { flex: 1 1 220dp; width: 220dp; }
.fav-save { min-height: 40dp; }
#fav-cancel { min-height: 40dp; }

/* ---------------------------------------------------------------- aside */
.recent-row { padding: 12dp 0dp; border-bottom: 1dp var(--line); }
.recent-address { font-family: "IBM Plex Mono"; font-size: 13dp; line-height: 18dp; word-break: break-all; }
.recent-actions { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8dp; margin-top: 8dp; }
.recent-tag { font-family: "IBM Plex Mono"; font-size: 11dp; line-height: 16dp; color: var(--text2); }
.clear-recent { min-height: 40dp; margin-top: 8dp; font-size: 13dp; }

.aside-note { padding: 12dp 0dp; font-size: 14dp; line-height: 20dp; color: var(--text2); }
.aside-note.quiet { padding-top: 0dp; font-family: "IBM Plex Mono"; font-size: 12dp; line-height: 18dp; }
