{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DeroXP/boiii-free/blob/xerces-main/docs/schema/mod-1.schema.json",
  "title": "Xerces mod manifest (xerces.mod.json), schema 1",
  "description": "Lives in the mod's root folder. See docs/DESIGN.md 5.2. Unknown fields are kept and warned about; xerces_cli mod validate checks semantics this schema cannot (files, hashes, hook targets).",
  "type": "object",
  "required": ["schema", "id", "name", "version"],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "description": "Stable id; never changes between versions."
    },
    "kind": { "enum": ["mod", "map"], "default": "mod" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": {
      "type": "string",
      "description": "SemVer 2.0.0.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "authors": { "type": "array", "items": { "type": "string" } },
    "license": {
      "type": "string",
      "description": "An SPDX licence expression."
    },
    "requires": {
      "type": "object",
      "properties": {
        "xerces": {
          "type": "string",
          "description": "npm-style range, for example \">=1.0 <2\"."
        },
        "modes": {
          "type": "array",
          "items": { "enum": ["zm", "mp", "cp"] }
        }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "workshop": {
          "type": "integer",
          "minimum": 1,
          "description": "Published file id."
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/properties/id" },
          "version": { "type": "string", "default": "*" },
          "optional": { "type": "boolean", "default": false }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/properties/id" },
          "reason": { "type": "string" }
        }
      }
    },
    "order": {
      "type": "object",
      "properties": {
        "after": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Load after (rank above) these mods."
        },
        "before": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Load before (rank below) these mods."
        },
        "priority": { "type": "integer", "default": 0 }
      }
    },
    "assets": {
      "type": "object",
      "properties": {
        "provides": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
        "overrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/asset" },
          "description": "Replacing an asset the game or another mod provides needs an entry here."
        },
        "extends": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/asset" },
              {
                "properties": {
                  "key": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0 },
                    "default": [0]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "scripts": {
      "type": "object",
      "properties": {
        "entry": { "type": "array", "items": { "type": "string" } },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "handler"],
            "properties": {
              "target": { "$ref": "#/$defs/function" },
              "handler": { "$ref": "#/$defs/function" },
              "kind": {
                "enum": ["before", "after", "wrap", "replace"],
                "default": "wrap",
                "description": "\"replace\" needs a matching assets.overrides entry."
              }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "native_code": { "type": "boolean", "default": false },
        "lua": {
          "type": "object",
          "properties": {
            "unsafe": { "type": "boolean", "default": false },
            "net": { "type": "array", "items": { "type": "string" } },
            "files": { "type": "array", "items": { "type": "string" } }
          }
        },
        "gsc": {
          "type": "object",
          "properties": {
            "exec_command": { "type": "boolean", "default": false },
            "files": { "type": "boolean", "default": false },
            "replacefunc": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "type", "default"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "type": { "enum": ["bool", "int", "float", "string", "enum"] },
          "default": {},
          "min": { "type": "number" },
          "max": { "type": "number" },
          "options": { "type": "array", "items": { "type": "string" } },
          "label": { "type": "string", "maxLength": 120 },
          "dvar": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "scope": {
            "enum": ["server", "client"],
            "default": "server",
            "description": "Server settings are part of the content id that joining players must match."
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "description": "Relative file path to its SHA-256.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Engine asset type: scriptparsetree, stringtable, rawfile, localize, weapon, ..."
        },
        "name": { "type": "string", "maxLength": 256 },
        "reason": { "type": "string" }
      }
    },
    "function": {
      "type": "string",
      "pattern": "^[^:]+\\.(gsc|csc)::[A-Za-z_][A-Za-z0-9_]*$",
      "description": "\"path/script.gsc::function\"."
    }
  }
}
